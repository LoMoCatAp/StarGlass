{
  "name": "starglass",
  "version": "0.9.2-dev",
  "private": true,
  "description": "Windows desktop GitHub monitor with GPU liquid glass",
  "author": "LomoCat",
  "license": "MIT",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "npm run native && npm run panel && npm run build && electron .",
    "test": "node --test tests/*.test.cjs",
    "native": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-native.ps1",
    "panel": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-panel.ps1",
    "pack": "npm run native && npm run panel && npm run build && electron-builder --win dir",
    "dist": "npm run native && npm run panel && npm run build && electron-builder --win portable"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.0.0",
    "vite": "^7.3.0"
  },
  "build": {
    "appId": "app.starglass.desktop",
    "productName": "StarGlass",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/icon.*",
      "assets/tray.png",
      "package.json",
      "THIRD_PARTY_NOTICES.md",
      "LICENSE",
      "licenses/**/*"
    ],
    "extraResources": [
      {
        "from": "assets/GlassCapture.exe",
        "to": "GlassCapture.exe"
      },
      {
        "from": "native/glass-panel/glasspanel.exe",
        "to": "glasspanel.exe"
      }
    ],
    "win": {
      "target": "portable",
      "icon": "assets/icon.ico",
      "signAndEditExecutable": true
    },
    "portable": {
      "artifactName": "StarGlass-${version}-Windows.exe"
    }
  },
  "homepage": "https://github.com/LoMoCatAp/StarGlass",
  "repository": {
    "type": "git",
    "url": "https://github.com/LoMoCatAp/StarGlass.git"
  },
  "bugs": {
    "url": "https://github.com/LoMoCatAp/StarGlass/issues"
  }
}
